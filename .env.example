# Registra una aplicación OAuth privada para la organización de Figma y copia estos datos aquí.
# Las personas que la usen deben pertenecer al equipo u organización asociada a esa app.
# No subas el archivo .env que crees a partir de esta plantilla.
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
# Debe coincidir exactamente con la URL de retorno configurada en Figma.
FIGMA_OAUTH_REDIRECT_URI=http://localhost:4173/api/figma/callback
# En producción, define HOST=0.0.0.0 y usa una URL HTTPS pública como retorno.
